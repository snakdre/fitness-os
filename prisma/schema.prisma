// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Required Models ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User Model ──────────────────────────────────────────────────────────

enum UserRole {
  USER
  COACH
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  profile            Profile?
  goals              Goal[]
  bodyMeasurements   BodyMeasurement[]
  workouts           Workout[]
  meals              Meal[]
  nutritionGoal      NutritionGoal?
  supplements        Supplement[]
  supplementLogs     SupplementLog[]
  shoppingLists      ShoppingList[]
  aiConversations    AIConversation[]
  analyticsEvents    AnalyticsEvent[]
  subscription       Subscription?
  coachRelationships CoachRelationship[] @relation("CoachRelationships")
  clientRelationships CoachRelationship[] @relation("ClientRelationships")
  auditLogs          AuditLog[]
  customExercises    Exercise[]
  customFoodItems    FoodItem[]

  @@index([email])
  @@index([role])
}

// ─── Profile ──────────────────────────────────────────────────────────────────

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Profile {
  id            String        @id @default(cuid())
  userId        String        @unique
  age           Int?
  gender        Gender?
  height        Float?        // in cm
  weight        Float?        // in kg
  activityLevel ActivityLevel @default(MODERATELY_ACTIVE)
  bio           String?       @db.Text
  avatarUrl     String?
  timezone      String        @default("UTC")
  dateOfBirth   DateTime?
  fitnessLevel  String?       // beginner, intermediate, advanced
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Goals ────────────────────────────────────────────────────────────────────

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  ENDURANCE
  STRENGTH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

model Goal {
  id            String     @id @default(cuid())
  userId        String
  type          GoalType
  targetWeight  Float?
  targetDate    DateTime?
  description   String?    @db.Text
  status        GoalStatus @default(ACTIVE)
  startWeight   Float?
  currentWeight Float?
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Body Measurements ────────────────────────────────────────────────────────

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  weight    Float?   // kg
  bodyFat   Float?   // percentage
  chest     Float?   // cm
  waist     Float?   // cm
  hips      Float?   // cm
  biceps    Float?   // cm
  thighs    Float?   // cm
  calves    Float?   // cm
  shoulders Float?   // cm
  neck      Float?   // cm
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

// ─── Exercises ────────────────────────────────────────────────────────────────

enum ExerciseCategory {
  STRENGTH
  CARDIO
  FLEXIBILITY
  BALANCE
  SPORTS
  OTHER
}

model Exercise {
  id           String           @id @default(cuid())
  name         String
  category     ExerciseCategory
  muscleGroups String[]         // e.g. ["chest", "triceps"]
  equipment    String[]         // e.g. ["barbell", "bench"]
  instructions String?          @db.Text
  videoUrl     String?
  imageUrl     String?
  isCustom     Boolean          @default(false)
  createdById  String?
  isPublic     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy        User?             @relation(fields: [createdById], references: [id])
  workoutExercises WorkoutExercise[]

  @@index([category])
  @@index([createdById])
  @@index([name])
}

// ─── Workouts ─────────────────────────────────────────────────────────────────

enum WorkoutStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model Workout {
  id          String        @id @default(cuid())
  userId      String
  name        String
  date        DateTime
  duration    Int?          // in minutes
  notes       String?       @db.Text
  status      WorkoutStatus @default(PLANNED)
  caloriesBurned Int?
  totalVolume Float?        // total weight lifted
  isTemplate  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]

  @@index([userId])
  @@index([date])
  @@index([status])
}

model WorkoutExercise {
  id         String  @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int
  notes      String? @db.Text
  restTime   Int?    // seconds between sets

  workout  Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id])
  sets     ExerciseSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model ExerciseSet {
  id                String  @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  reps              Int?
  weight            Float?  // kg
  duration          Int?    // seconds (for timed sets)
  distance          Float?  // km (for cardio)
  isCompleted       Boolean @default(false)
  rpe               Int?    // Rate of Perceived Exertion 1-10
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

// ─── Nutrition ────────────────────────────────────────────────────────────────

model FoodItem {
  id          String  @id @default(cuid())
  name        String
  brand       String?
  calories    Float   // per serving
  protein     Float   // grams per serving
  carbs       Float   // grams per serving
  fat         Float   // grams per serving
  fiber       Float?  // grams per serving
  sodium      Float?  // mg per serving
  sugar       Float?  // grams per serving
  servingSize Float   @default(100)
  servingUnit String  @default("g")
  barcode     String? @unique
  isCustom    Boolean @default(false)
  createdById String?
  isPublic    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?      @relation(fields: [createdById], references: [id])
  mealItems MealItem[]

  @@index([name])
  @@index([barcode])
  @@index([createdById])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mealType  MealType
  name      String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealItems MealItem[]

  @@index([userId])
  @@index([date])
  @@index([mealType])
}

model MealItem {
  id          String @id @default(cuid())
  mealId      String
  foodItemId  String
  quantity    Float  // multiplier of serving
  servingSize Float
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?

  meal     Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@index([mealId])
  @@index([foodItemId])
}

model NutritionGoal {
  id        String   @id @default(cuid())
  userId    String   @unique
  calories  Int
  protein   Float    // grams
  carbs     Float    // grams
  fat       Float    // grams
  fiber     Float?   // grams
  water     Float?   // liters
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Supplements ──────────────────────────────────────────────────────────────

model Supplement {
  id           String    @id @default(cuid())
  userId       String
  name         String
  brand        String?
  dosage       Float
  unit         String    // mg, g, ml, capsules, etc.
  frequency    String    // daily, twice daily, etc.
  instructions String?   @db.Text
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean   @default(true)
  category     String?   // protein, vitamin, mineral, etc.
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs SupplementLog[]

  @@index([userId])
  @@index([isActive])
}

model SupplementLog {
  id           String   @id @default(cuid())
  supplementId String
  userId       String
  takenAt      DateTime @default(now())
  dosage       Float
  notes        String?

  supplement Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([supplementId])
  @@index([userId])
  @@index([takenAt])
}

// ─── Shopping Lists ───────────────────────────────────────────────────────────

model ShoppingList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  generatedAt DateTime @default(now())
  aiGenerated Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]

  @@index([userId])
}

model ShoppingListItem {
  id             String  @id @default(cuid())
  shoppingListId String
  name           String
  quantity       Float?
  unit           String?
  category       String? // produce, dairy, protein, etc.
  isPurchased    Boolean @default(false)
  estimatedCost  Float?
  brand          String?
  notes          String?

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

// ─── AI Conversations ─────────────────────────────────────────────────────────

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  context   String?  @db.Text // JSON string of context data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  tokens         Int?
  createdAt      DateTime    @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  event      String
  properties Json?
  timestamp  DateTime @default(now())
  sessionId  String?
  ipAddress  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([event])
  @@index([timestamp])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  FREE
  PRO
  COACH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

// ─── Coach Relationships ──────────────────────────────────────────────────────

enum RelationshipStatus {
  PENDING
  ACTIVE
  PAUSED
  ENDED
}

model CoachRelationship {
  id        String             @id @default(cuid())
  coachId   String
  clientId  String
  status    RelationshipStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  notes     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  coach  User @relation("CoachRelationships", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientRelationships", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource   String   // User, Workout, Meal, etc.
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}
